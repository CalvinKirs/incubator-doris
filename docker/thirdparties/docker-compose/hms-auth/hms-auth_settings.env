# Hive Metastore 1.1.0 with Hive SQL Standard authorization, for the HMS native authorization plugin suites.
# Started only by: run-thirdparties-docker.sh --hms-auth   (never part of the default or "all" component sets)

# Every listener binds this address. The fixture is single-host: FE, BE and the regression runner share it.
export HMS_AUTH_HOST="127.0.0.1"

export HMS_AUTH_FS_PORT=8720         # HDFS NameNode RPC; hmsAuthHdfsUri in regression-conf.groovy
export HMS_AUTH_NN_HTTP_PORT=8770
export HMS_AUTH_DN_PORT=8710
export HMS_AUTH_DN_IPC_PORT=8711
export HMS_AUTH_DN_HTTP_PORT=8775
export HMS_AUTH_HMS_PORT=9783        # simple-auth metastore; hmsAuthUri
export HMS_AUTH_HS2_PORT=10783       # HiveServer2 with SQL Standard authorization; hmsAuthHs2Jdbc
export HMS_AUTH_KDC_PORT=8788
export HMS_AUTH_KRB_HMS_PORT=9793    # SASL metastore; hmsKrbUri

export HMS_AUTH_REALM="HMS.AUTH.TEST"

# The target server version. The archive is verified before it enters the image build context.
export HMS_AUTH_HIVE_VERSION="1.1.0"
export HMS_AUTH_HIVE_URL="https://archive.apache.org/dist/hive/hive-1.1.0/apache-hive-1.1.0-bin.tar.gz"
export HMS_AUTH_HIVE_SHA256="7af11f13054f9aaba123457c95fedbacf44b8bd38c4fb522eba0ece9b1365c1f"
