{
  "realm": "doris",
  "enabled": true,
  "displayName": "Doris Local OIDC",
  "sslRequired": "none",
  "registrationAllowed": false,
  "loginWithEmailAllowed": true,
  "duplicateEmailsAllowed": false,
  "resetPasswordAllowed": false,
  "rememberMe": false,
  "accessTokenLifespan": 10800,
  "ssoSessionIdleTimeout": 10800,
  "ssoSessionMaxLifespan": 10800,
  "groups": [
    {
      "name": "doris_analyst"
    },
    {
      "name": "doris_dashboard_readonly"
    }
  ],
  "clientScopes": [
    {
      "name": "doris.query",
      "description": "Doris query scope used by access-token regression tests",
      "protocol": "openid-connect",
      "attributes": {
        "include.in.token.scope": "true",
        "display.on.consent.screen": "false"
      }
    },
    {
      "name": "doris.profile",
      "description": "Optional Doris profile scope used by access-token regression tests",
      "protocol": "openid-connect",
      "attributes": {
        "include.in.token.scope": "true",
        "display.on.consent.screen": "false"
      }
    },
    {
      "name": "doris-groups-array",
      "description": "Emit doris_groups as a string array",
      "protocol": "openid-connect",
      "attributes": {
        "include.in.token.scope": "true",
        "display.on.consent.screen": "false"
      },
      "protocolMappers": [
        {
          "name": "doris-groups-array",
          "protocol": "openid-connect",
          "protocolMapper": "oidc-group-membership-mapper",
          "consentRequired": false,
          "config": {
            "full.path": "false",
            "id.token.claim": "false",
            "access.token.claim": "true",
            "userinfo.token.claim": "false",
            "claim.name": "doris_groups"
          }
        }
      ]
    },
    {
      "name": "doris-groups-csv",
      "description": "Emit doris_groups as a comma-separated string for boundary testing",
      "protocol": "openid-connect",
      "attributes": {
        "include.in.token.scope": "true",
        "display.on.consent.screen": "false"
      },
      "protocolMappers": [
        {
          "name": "doris-groups-csv",
          "protocol": "openid-connect",
          "protocolMapper": "oidc-usermodel-attribute-mapper",
          "consentRequired": false,
          "config": {
            "user.attribute": "doris_groups_csv",
            "claim.name": "doris_groups",
            "jsonType.label": "String",
            "id.token.claim": "false",
            "access.token.claim": "true",
            "userinfo.token.claim": "false"
          }
        }
      ]
    }
  ],
